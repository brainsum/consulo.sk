<?php

/**
 * Implements hook_preprocess_HOOK().
 */

function consulo_theme_preprocess_block(&$variables) {
  if ($variables['plugin_id'] !== 'page_title_block') {
    return;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node && $node->hasField('field_image') && $file = $node->get('field_image')->entity) {
    $variables['headerImage'] = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
  }
}


function consulo_theme_preprocess_html(&$variables) {
  // Add node id to the body class.
  $node = \Drupal::routeMatch()->getParameter('node');
  if($node) {
    $variables['attributes']['class'][] = 'node-' . $node->id();
  }
}
